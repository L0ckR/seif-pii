      "new_fp_characters": 43,
      "explanation": "Address labels spuriously cover generic banking words, subword fragments, a payment-brand mention, and a business-office reference. Mapping these six address labels to LOCATION exposes the broader address taxonomy through the geographic-name gateway."
    },
    {
      "kind": "nonpersonal_mixed_case_word_fragment_labeled_as_surname",
      "case_ids": [
        "org_0212"
      ],
      "new_fp_characters": 2,
      "explanation": "A fragment inside a generic institutional word is labeled LAST_NAME and survives unchanged service filtering."
    },
    {
      "kind": "missing_name_boundary_characters",
      "case_ids": [
        "org_0202",
        "org_0373"
      ],
      "new_fn_characters": 2,
      "certain_case_ids": [
        "org_0373"
      ],
      "explanation": "One standalone lowercase name loses its final letter; a punctuated initial before a name is omitted. Coarse whitespace joining cannot restore characters not predicted by the native model."
    },
    {
      "kind": "untyped_metric_credit_from_reference_wrong_entity_type",
      "case_ids": [
        "org_0381"
      ],
      "new_fn_characters": 20,
      "uncertain": true,
      "explanation": "GLiNER calls two unlabelled number groups PERSON; silver gold treats them as passports, so untyped masking rewards the incorrect semantic type. RuBERT gateway omits native PASSPORT/PHONE predictions by its predeclared PERSON/LOCATION scope; native outputs are themselves fragmented. This is not evidence that name recognition lost 20 characters."
    },
    {
      "kind": "apparent_improvement_from_partial_name_detection_on_uncertain_negative",
      "case_ids": [
        "org_0249"
      ],
      "removed_fp_characters": 4,
      "uncertain": true,
      "explanation": "Silver gold excludes a context-free literary surname. Both models still mask it; RuBERT truncates one part and is rewarded for masking 4 fewer letters. No exact-case success is gained."
    }
  ],
