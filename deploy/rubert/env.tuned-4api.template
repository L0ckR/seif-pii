# Current non-secret candidate; pass AFTER --env-file .env.rubert.
# Two API containers with two workers each; two independent NER processes.
# Confirm sustained performance with an open-loop test through shared Redis.
SEIF_API_WORKERS=2
SEIF_API_MEMORY=1g
SEIF_API_PROXY_MAXCONN=256
SEIF_CPU_WORKERS=1
SEIF_RUBERT_CPU_THREADS=1
SEIF_NER_HTTP_BACKEND=aiohttp
SEIF_NER_MAX_CONCURRENCY=32
SEIF_LOG_LEVEL=INFO
SEIF_MAX_INFLIGHT=256
SEIF_NER_MAX_MODEL_JOBS=128
SEIF_NER_MAX_HTTP_INFLIGHT=256
SEIF_NER_BATCH_SIZE=32
SEIF_NER_BATCH_WAIT_MS=2.0
SEIF_NER_PROXY_MAXCONN=512
# Capacity starting point, not a completed full-TTL memory measurement.
SEIF_REDIS_MAXMEMORY=4gb
SEIF_REDIS_MEMORY=5g
