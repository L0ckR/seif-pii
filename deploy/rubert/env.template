# Copy into a NEW ignored file at repository root: .env.rubert
# Do not overwrite a running service's existing .env or rotate its master key.
SEIF_MASTER_KEY=
SEIF_DEMO_API_KEY=
SEIF_NER_TOKEN=
SEIF_REDIS_PASSWORD=
SEIF_RUBERT_MODEL_HOST_PATH=

# Both NER replicas share GPU 0 by default. For two GPUs set GPU_2=1 (or UUID).
SEIF_NER_GPU_1=0
SEIF_NER_GPU_2=0
SEIF_RUBERT_API_PORT=8785
SEIF_API_WORKERS=1
SEIF_API_MEMORY=1g
SEIF_API_PROXY_MAXCONN=64
SEIF_CPU_WORKERS=4
SEIF_RUBERT_CPU_THREADS=4
SEIF_NER_HTTP_BACKEND=httpx
SEIF_NER_MAX_CONCURRENCY=4
SEIF_LOG_LEVEL=INFO
SEIF_MAX_INFLIGHT=128
SEIF_NER_PROXY_MAXCONN=256
SEIF_NER_MAX_MODEL_JOBS=4
SEIF_NER_MAX_HTTP_INFLIGHT=16
SEIF_NER_BATCH_SIZE=1
SEIF_NER_BATCH_WAIT_MS=1.0
SEIF_NER_MEMORY=4g
SEIF_REDIS_MAXMEMORY=1gb
SEIF_REDIS_MEMORY=1200m
SEIF_TTL_SECONDS=900
