# Non-secret tuning overlay; pass AFTER --env-file .env.rubert.
# Previous HTTPX baseline, retained for controlled comparison.
# Not a guarantee of sustained 2000 successful masks/s.
# Existing two API containers each start four workers: eight processes total.
SEIF_API_WORKERS=4
SEIF_API_MEMORY=2g
SEIF_API_PROXY_MAXCONN=192
SEIF_CPU_WORKERS=1
SEIF_RUBERT_CPU_THREADS=1
SEIF_NER_HTTP_BACKEND=httpx
SEIF_NER_MAX_CONCURRENCY=16
SEIF_LOG_LEVEL=INFO
SEIF_MAX_INFLIGHT=128
SEIF_NER_MAX_MODEL_JOBS=128
SEIF_NER_MAX_HTTP_INFLIGHT=256
SEIF_NER_BATCH_SIZE=32
SEIF_NER_BATCH_WAIT_MS=2.0
SEIF_NER_PROXY_MAXCONN=512
# Capacity starting point; measure bytes/record and memory over a complete TTL.
# Redis memory limit includes headroom above its own noeviction maxmemory.
SEIF_REDIS_MAXMEMORY=4gb
SEIF_REDIS_MEMORY=5g
